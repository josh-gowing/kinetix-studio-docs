// v1.8 example: strategy logic runs on completed primary bars while fills are
// reconstructed from an imported lower-timeframe OHLCV dataset.
// Replace both dataset references with matching Data Library names.
strategy({
  name: "Bar Magnifier v1.8",
  dataset: "eur_usd_1d",
  executionMode: "bar_magnifier",
  intrabarDataset: "eur_usd_1h",
  initialCapital: 100000,
  defaultQtyType: "percent_equity",
  defaultQtyValue: 20
});

const fast = ta.ema(close, 20);
const slow = ta.ema(close, 50);

if (ta.crossover(fast, slow) && strategy.positionSize == 0) {
  strategy.entry("Long", strategy.long);
}

if (strategy.positionSize > 0) {
  strategy.exit("Risk", "Long", {
    stop: strategy.positionAvgPrice * 0.97,
    limit: strategy.positionAvgPrice * 1.06
  });
}

plot.line(fast, { title: "EMA 20" });
plot.line(slow, { title: "EMA 50" });
