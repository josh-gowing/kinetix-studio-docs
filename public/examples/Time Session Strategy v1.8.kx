// v1.8 example: executable time.* and session.* APIs.
// Change dataset to an imported intraday OHLCV dataset.
strategy({
  name: "Session Filter v1.8",
  dataset: "eur_usd_1h",
  initialCapital: 100000,
  defaultQtyType: "percent_equity",
  defaultQtyValue: 20
});

const london = session.define("0800-1630", {
  timezone: "Europe/London",
  days: "12345"
});

const fast = ta.ema(close, 20);
const slow = ta.ema(close, 50);
const inSession = session.isOpen(london);

if (inSession && ta.crossover(fast, slow) && strategy.positionSize == 0) {
  strategy.entry("Long", strategy.long);
}

if (strategy.positionSize > 0 && (!inSession || ta.crossunder(fast, slow))) {
  strategy.close("Long");
}

plot.line(fast, { title: "EMA 20" });
plot.line(slow, { title: "EMA 50" });
