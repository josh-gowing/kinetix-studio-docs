// v1.7 example: broker-aware strategy state, scale-outs and trailing exits.
strategy({
  name: "Broker Aware v1.7",
  dataset: "eur_usd_1d",
  initialCapital: 100000,
  commissionType: "percent",
  commission: 0.0001,
  pyramiding: 1,
  defaultQtyType: "percent_equity",
  defaultQtyValue: 20
});

const fast = ta.ema(close, 20);
const slow = ta.ema(close, 50);
const longSignal = ta.crossover(fast, slow);

// Broker state is evaluated sequentially on each completed bar.
if (longSignal && strategy.positionSize == 0) {
  strategy.entry("Long", strategy.long);
}

// Two independent scale-out targets can coexist.
if (strategy.positionSize > 0) {
  strategy.exit("Target 1", {
    from: "Long",
    qtyPercent: 50,
    limit: strategy.positionAvgPrice * 1.04,
    stop: strategy.positionAvgPrice * 0.97
  });

  strategy.exit("Runner", {
    from: "Long",
    qtyPercent: 100,
    // Keep an initial protective stop active until/alongside the trail.
    // If Target 1 stops out 50%, Runner can close the remaining position
    // rather than leaving a residual position waiting for trail activation.
    stop: strategy.positionAvgPrice * 0.97,
    trailOffset: strategy.positionAvgPrice * 0.02,
    trailPoints: strategy.positionAvgPrice * 0.015
  });
}

plot.line(fast, { title: "EMA 20" });
plot.line(slow, { title: "EMA 50" });
